## 📜 6. Сервер логирования Syslog + Ротация (Сервер HQ-SRV)## На сервере (HQ-SRV):
Используем rsyslog. Правим /etc/rsyslog.conf (раскомментируем UDP-модуль на порту 514):

$ModLoad imudp
$UDPServerRun 514

# Шаблон динамического распределения папок по имени хоста (исключая localhost)
$template RemoteLogs,"/opt/%HOSTNAME%/%PROGRAMNAME%.log"
if $fromhost-ip != '127.0.0.1' and $syslogseverity <= 4 then ?RemoteLogs
& stop

systemctl restart rsyslog

## Настройка ротации логов (/etc/logrotate.d/syslog-opt):

/opt/*/*.log {
    weekly
    size 10M
    compress
    missingok
    notifempty
    sharedscripts
    postrotate
        /bin/kill -HUP `cat /var/run/rsyslogd.pid 2> /dev/null` 2> /dev/null || true
    endscript
}

