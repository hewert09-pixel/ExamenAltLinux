## 🤖 8. Инвентаризация через Ansible Playbook (Сервер BR-SRV)
Создаем плейбук /etc/ansible/get_info.yml на базе файла из Additional.iso:

---
- name: Сбор инвентаризационных данных
  hosts: hq_srv, hq_cli
  gather_facts: yes
  tasks:
    - name: Создание структуры каталога отчетов
      file:
        path: /etc/ansible/PC-INFO
        state: directory
      delegate_to: localhost

    - name: Генерация YAML-отчета
      template:
        src: report.yml.j2
        dest: "/etc/ansible/PC-INFO/{{ ansible_hostname }}.yml"
      delegate_to: localhost

Шаблон report.yml.j2:

Hostname: "{{ ansible_hostname }}"
IP_Address: "{{ ansible_default_ipv4.address }}"

