Используйте код с осторожностью.
2. Конфигурация Nginx (/etc/nginx/nginx.conf или conf.d/proxy.conf)
nginx
# Прокси для web.au-team.irpo -> HQ-SRV
server {
    listen 80;
    server_name web.au-team.irpo;

    location / {
        auth_basic "Restricted Access";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://<Внешний_IP_HQ-RTR>:8080; 
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# Прокси для docker.au-team.irpo -> BR-SRV (Docker)
server {
    listen 80;
    server_name docker.au-team.irpo;

    location / {
        # Здесь аутентификация по условию не требуется
        proxy_pass http://<Внешний_IP_BR-RTR>:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
Используйте код с осторожностью.
