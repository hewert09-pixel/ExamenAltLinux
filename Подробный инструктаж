Задание 3. Защищенный туннель IPsec (EcoRouter)
Конфигурация фаз шифрования IKEv2/IPsec на HQ-RTR (на стороне BR-RTR настраивается зеркально):
text
crypto ikev2 policy GOST_IKE
 encryption aes-256
 integrity sha256
 group 14
exit

crypto ikev2 profile GOST_PROF
 match identity remote address 172.16.2.2 # Внешний IP BR-RTR
 identity local address 172.16.1.2        # Внешний IP HQ-RTR
 authentication local pre-shared-key TopSecretPass
 authentication remote pre-shared-key TopSecretPass
exit

crypto ipsec transform-set GOST_ESP esp-aes-256 esp-sha256-hmac
 mode tunnel
exit

crypto ipsec profile IPSEC_GOST_PROFILE
 set transform-set GOST_ESP
 set ikev2-profile GOST_PROF
exit

interface tunnel0
 tunnel protection ipsec profile IPSEC_GOST_PROFILE
exit
Используйте код с осторожностью.
